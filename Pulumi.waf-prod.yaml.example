environment:
  - secure-saas-infra/production
config:
  # CloudFront-scope WAF web ACL must live in us-east-1.
  aws:region: us-east-1
  secure-saas-infra:stackKind: waf
  secure-saas-infra:deploymentMode: disabled
  secure-saas-infra:organizationName: deus
  secure-saas-infra:environment: waf-prod
  secure-saas-infra:waf:
    name: public-ingress-prod
    scope: CLOUDFRONT
    rateLimitPer5Minutes: 5000
    enableBotControl: true
    modelGatewayPathPrefixes:
      - /v1/models
      - /v1/agents
    modelGatewayRateLimitPer5Minutes: 500
