{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security.deus.dev/schemas/bootstrap-candidate-v1.schema.json",
  "title": "Immutable credential-free AWS bootstrap preview candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "generatedAt",
    "signingKeyId",
    "source",
    "configuration",
    "pulumiBackend",
    "build",
    "localGateEvidence",
    "nativeLauncher",
    "releaseEvidence",
    "tools",
    "runtime",
    "runtimeProvenance",
    "sealInventory",
    "candidateDigest",
    "signature"
  ],
  "properties": {
    "apiVersion": { "const": "security.deus.dev/bootstrap-candidate/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "signingKeyId": { "$ref": "#/$defs/sha256" },
    "source": { "$ref": "#/$defs/source" },
    "configuration": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/file" }
    },
    "pulumiBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "organization"],
      "properties": {
        "kind": { "const": "pulumi-cloud" },
        "url": {
          "const": "https://api.pulumi.com"
        },
        "organization": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "treeDigest"],
      "properties": {
        "path": { "const": "dist-management-seed" },
        "treeDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "localGateEvidence": { "$ref": "#/$defs/evidence" },
    "nativeLauncher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "artifacts/deus-aws-bootstrap" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "releaseEvidence": { "$ref": "#/$defs/evidence" },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm", "pulumi", "aws", "git"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "npm": { "type": "string", "minLength": 1 },
        "pulumi": { "type": "string", "minLength": 1 },
        "aws": { "type": "string", "minLength": 1 },
        "git": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "runtimeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "/usr/local/lib/deus-bootstrap/runtime-provenance.json"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sealInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "entryCount",
        "totalFileBytes",
        "maximumFileSize"
      ],
      "properties": {
        "path": { "const": "artifacts/bootstrap-seal-inventory.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "entryCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "totalFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "maximumFileSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        }
      }
    },
    "candidateDigest": { "$ref": "#/$defs/sha256" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "$ref": "#/$defs/sha256" },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty", "treeDigest"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "dirty": { "const": false },
        "treeDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "evidenceDigest"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "evidenceDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "locator": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "realPath", "sha256", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "path": { "$ref": "#/$defs/locator" },
        "realPath": { "$ref": "#/$defs/locator" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "realPath", "treeDigest"],
      "properties": {
        "name": {
          "enum": [
            "aws-cli-install",
            "dependencies",
            "policy-build",
            "pulumi-install"
          ]
        },
        "path": { "$ref": "#/$defs/locator" },
        "realPath": { "$ref": "#/$defs/locator" },
        "treeDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "path", "realPath", "treeDigest"],
      "properties": {
        "kind": { "const": "resource" },
        "name": { "const": "aws" },
        "version": { "const": "7.27.0" },
        "path": { "$ref": "#/$defs/locator" },
        "realPath": { "$ref": "#/$defs/locator" },
        "treeDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executables", "directories", "pulumiPlugins"],
      "properties": {
        "executables": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/executable" }
        },
        "directories": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/directory" }
        },
        "pulumiPlugins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/plugin" }
        }
      }
    }
  }
}
