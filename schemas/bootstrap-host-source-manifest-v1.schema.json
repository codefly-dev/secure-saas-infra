{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security.deus.dev/schemas/bootstrap-host-source-manifest-v1.schema.json",
  "title": "Bootstrap Host Source Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "releaseTag",
    "sourceRevision",
    "files",
    "manifestDigest"
  ],
  "properties": {
    "apiVersion": {
      "const": "security.deus.dev/bootstrap-host-source-manifest/v1"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[+-][A-Za-z0-9.-]+)?$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "executable", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!\\.\\.?$)(?!\\.\\.?/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^/\\u0000-\\u001f\\u007f])?$"
          },
          "executable": { "type": "boolean" },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
