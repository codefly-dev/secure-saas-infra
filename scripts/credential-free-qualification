#!/bin/sh
set -eu

if [ -n "${NODE_OPTIONS-}${NODE_PATH-}${BUN_OPTIONS-}${DENO_DIR-}${AWS_ACCESS_KEY_ID-}${AWS_SECRET_ACCESS_KEY-}${AWS_SESSION_TOKEN-}${AWS_PROFILE-}${AWS_DEFAULT_PROFILE-}${AWS_CONFIG_FILE-}${AWS_SHARED_CREDENTIALS_FILE-}${AWS_WEB_IDENTITY_TOKEN_FILE-}${AWS_ROLE_ARN-}${AWS_CONTAINER_CREDENTIALS_RELATIVE_URI-}${AWS_CONTAINER_CREDENTIALS_FULL_URI-}${PULUMI_ACCESS_TOKEN-}${PULUMI_CONFIG_PASSPHRASE-}${PULUMI_CONFIG_PASSPHRASE_FILE-}${PULUMI_HOME-}${GITHUB_TOKEN-}${GH_TOKEN-}${NPM_TOKEN-}${NODE_AUTH_TOKEN-}${SSH_AUTH_SOCK-}" ]; then
  echo "credential-free-qualification: credential or executable indirection is forbidden" >&2
  exit 64
fi

case "$0" in
  /*) launcher=$0 ;;
  *) launcher=$PWD/$0 ;;
esac
repository=$(CDPATH= cd -- "${launcher%/*}/.." && pwd -P)
trusted_metadata() {
  if [ -x /usr/bin/sw_vers ]; then
    metadata=$(/usr/bin/stat -f '%u:%Lp' "$1")
  else
    metadata=$(/usr/bin/stat -c '%u:%a' "$1")
  fi
  case "$metadata" in
    0:555|0:755) return 0 ;;
    *) return 1 ;;
  esac
}
trusted_node=/usr/local/lib/deus-bootstrap/bin/node
for candidate in \
  /usr \
  /usr/local \
  /usr/local/lib \
  /usr/local/lib/deus-bootstrap \
  /usr/local/lib/deus-bootstrap/bin \
  "$trusted_node"
do
  if [ -L "$candidate" ] || ! trusted_metadata "$candidate"; then
    echo "credential-free-qualification: fixed bootstrap Node chain is not root-owned and protected: $candidate" >&2
    exit 78
  fi
done
if [ -z "$trusted_node" ]; then
  echo "credential-free-qualification: trusted bootstrap Node is unavailable; install a non-user-writable Node at /usr/local/lib/deus-bootstrap/bin/node" >&2
  exit 78
fi
isolated_home=$(/usr/bin/mktemp -d /tmp/deus-seed-qualification-home.XXXXXX)
cleanup() { /bin/rm -rf "$isolated_home"; }
trap cleanup EXIT HUP INT TERM

unset NODE_OPTIONS NODE_PATH BUN_OPTIONS DENO_DIR
export HOME="$isolated_home"
export NPM_CONFIG_USERCONFIG=/dev/null
export PULUMI_HOME="$repository/artifacts/bootstrap-pulumi-home"
export PULUMI_DISABLE_AUTOMATIC_PLUGIN_ACQUISITION=true
export PULUMI_IGNORE_AMBIENT_PLUGINS=true
export DEUS_PRODUCTION_QUALIFICATION=1
export DEUS_TRUSTED_GO=/usr/local/lib/deus-bootstrap/toolchains/go/bin/go
export PATH=/usr/local/lib/deus-bootstrap/bin:/usr/local/lib/deus-bootstrap/qualification-bin:/usr/local/lib/deus-bootstrap/toolchains/go/bin:/usr/bin:/bin
"$trusted_node" "$repository/scripts/qualify-bootstrap-candidate.mjs" "$@"
