#!/bin/sh
set -eu

version=8.30.1
system=$(/usr/bin/uname -s)
machine=$(/usr/bin/uname -m)

case "$system:$machine" in
  Darwin:arm64)
    archive="gitleaks_${version}_darwin_arm64.tar.gz"
    expected_sha256=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5
    ;;
  Darwin:x86_64)
    archive="gitleaks_${version}_darwin_x64.tar.gz"
    expected_sha256=dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709
    ;;
  Linux:aarch64 | Linux:arm64)
    archive="gitleaks_${version}_linux_arm64.tar.gz"
    expected_sha256=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
    ;;
  Linux:x86_64 | Linux:amd64)
    archive="gitleaks_${version}_linux_x64.tar.gz"
    expected_sha256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
    ;;
  *)
    /bin/echo "source secret scan: unsupported platform $system/$machine" >&2
    exit 1
    ;;
esac

script_directory=${0%/*}
repository=$(CDPATH= cd -- "$script_directory/.." && /bin/pwd -P)
temporary=$(/usr/bin/mktemp -d /tmp/deus-source-secret-scan.XXXXXX)
cleanup() {
  /bin/rm -rf "$temporary"
}
trap cleanup EXIT HUP INT TERM

url="https://github.com/gitleaks/gitleaks/releases/download/v${version}/${archive}"
/usr/bin/curl \
  --fail \
  --location \
  --proto '=https' \
  --silent \
  --show-error \
  --tlsv1.2 \
  --output "$temporary/$archive" \
  "$url"

if [ "$system" = Darwin ]; then
  actual_sha256=$(/usr/bin/shasum -a 256 "$temporary/$archive" | /usr/bin/awk '{print $1}')
else
  actual_sha256=$(/usr/bin/sha256sum "$temporary/$archive" | /usr/bin/awk '{print $1}')
fi
if [ "$actual_sha256" != "$expected_sha256" ]; then
  /bin/echo "source secret scan: Gitleaks archive checksum mismatch" >&2
  exit 1
fi

/usr/bin/tar -xzf "$temporary/$archive" -C "$temporary" gitleaks
if [ "$("$temporary/gitleaks" version)" != "$version" ]; then
  /bin/echo "source secret scan: Gitleaks version mismatch" >&2
  exit 1
fi

/bin/mkdir "$temporary/home"
/bin/mkdir "$temporary/worktree"
(
  cd "$repository"
  /usr/bin/git ls-files -co --exclude-standard -z > "$temporary/files"
)
/usr/bin/tar \
  -C "$repository" \
  --null \
  -T "$temporary/files" \
  -cf "$temporary/worktree.tar"
/usr/bin/tar -C "$temporary/worktree" -xf "$temporary/worktree.tar"

(
  cd "$temporary/worktree"
  /usr/bin/env -i \
    HOME="$temporary/home" \
    LANG=C \
    PATH=/usr/bin:/bin \
    "$temporary/gitleaks" dir \
      --gitleaks-ignore-path "$repository/.gitleaksignore" \
      --no-banner \
      --redact=100 \
      .
)

(
  cd "$repository"
  /usr/bin/env -i \
    HOME="$temporary/home" \
    LANG=C \
    PATH=/usr/bin:/bin \
    "$temporary/gitleaks" git \
      --gitleaks-ignore-path "$repository/.gitleaksignore" \
      --log-opts=--all \
      --no-banner \
      --redact=100 \
      "$repository"
)
