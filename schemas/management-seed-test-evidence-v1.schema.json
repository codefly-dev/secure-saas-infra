{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security.deus.dev/schemas/management-seed-test-evidence-v1.schema.json",
  "title": "Deterministic management-seed unit and hostile-test evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "toolchain",
    "inputs",
    "inputAggregateSha256",
    "results",
    "testCases"
  ],
  "properties": {
    "apiVersion": {
      "const": "evidence.security.deus.dev/management-seed-tests/v1"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm", "runner"],
      "properties": {
        "node": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "npm": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "runner": { "const": "node:test" }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fileDigest" }
    },
    "inputAggregateSha256": { "$ref": "#/$defs/sha256" },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "passed", "failed", "skipped", "todo"],
      "properties": {
        "tests": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "todo": { "type": "integer", "minimum": 0 }
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "name", "status", "failureCode"],
        "properties": {
          "file": { "$ref": "#/$defs/path" },
          "name": { "type": "string", "minLength": 1, "maxLength": 512 },
          "status": {
            "enum": ["passed", "failed", "skipped", "todo"]
          },
          "failureCode": {
            "type": ["string", "null"],
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
