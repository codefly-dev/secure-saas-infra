{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security.deus.dev/schemas/system-runtime-closure-v1.schema.json",
  "title": "System Runtime Closure v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "architecture", "loaders", "libraries"],
  "properties": {
    "apiVersion": {
      "const": "security.deus.dev/system-runtime-closure/v1"
    },
    "architecture": { "enum": ["amd64", "arm64"] },
    "loaders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/systemFile" }
    },
    "libraries": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/systemFile" }
    }
  },
  "$defs": {
    "systemFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/(?:usr/)?lib/(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
