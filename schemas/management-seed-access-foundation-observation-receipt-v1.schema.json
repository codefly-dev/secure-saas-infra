{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security.deus.dev/schemas/management-seed-access-foundation-observation-receipt-v1.schema.json",
  "title": "Management-seed access foundation observation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "generatedAt",
    "candidateDigest",
    "bundleDigest",
    "managementAccountId",
    "awsPartition",
    "region",
    "callerArn",
    "foundationAttestationDigest",
    "cloudControlPlaneMutationPerformed",
    "iamMutationPerformed",
    "receiptDigest"
  ],
  "properties": {
    "apiVersion": {
      "const": "security.deus.dev/management-seed-access-foundation-observation-receipt/v1"
    },
    "kind": {
      "const": "ManagementSeedAccessFoundationObservationReceipt"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "candidateDigest": { "$ref": "#/$defs/sha256" },
    "bundleDigest": { "$ref": "#/$defs/sha256" },
    "managementAccountId": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "awsPartition": { "const": "aws" },
    "region": {
      "type": "string",
      "pattern": "^(?!cn-|us-gov-)[a-z]{2}-[a-z]+-[0-9]$"
    },
    "callerArn": {
      "type": "string",
      "pattern": "^arn:aws:sts::[0-9]{12}:assumed-role/ManagementSeedProvisioner/[A-Za-z0-9+=,.@_-]+$"
    },
    "foundationAttestationDigest": { "$ref": "#/$defs/sha256" },
    "cloudControlPlaneMutationPerformed": { "const": false },
    "iamMutationPerformed": { "const": false },
    "receiptDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
