environment:
  - secure-saas-infra/dev
config:
  aws:region: us-east-1
  secure-saas-infra:stackKind: ingress
  secure-saas-infra:deploymentMode: disabled
  secure-saas-infra:organizationName: deus
  secure-saas-infra:environment: ingress-dev
  secure-saas-infra:ingress:
    domainName: dev.mind.example
    subjectAlternativeNames: []
    # Hosted zone created by the dns stack; bootstrap script populates this.
    hostedZoneId: <set-from-dns-stack>
    # Internal NLB ARN exported by the platform-dev stack.
    internalNlbArn: <set-from-platform-dev-stack>
    originDomainName: <set-from-platform-dev-stack>
    # CLOUDFRONT-scope WAF web ACL ARN exported by the waf-dev stack.
    webAclArn: <set-from-waf-dev-stack>
    priceClass: PriceClass_100
    minimumTlsVersion: TLSv1.2_2021
    geoRestrictionType: none
    geoRestrictionLocations: []
    modelGatewayPathPrefixes:
      - /v1/models
      - /v1/agents
    contentSecurityPolicy: "default-src 'self'"
    logRetentionDays: 365
