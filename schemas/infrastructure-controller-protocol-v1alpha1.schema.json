{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security.deus.dev/schemas/infrastructure-controller-protocol-v1alpha1.schema.json",
  "title": "Infrastructure controller public protocol contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "currentProtocolVersion",
    "supportedProtocolVersions",
    "reasonCodes",
    "examples"
  ],
  "properties": {
    "apiVersion": { "$ref": "#/$defs/apiVersion" },
    "kind": { "const": "InfrastructureControllerProtocolContract" },
    "currentProtocolVersion": { "$ref": "#/$defs/protocolVersion" },
    "supportedProtocolVersions": { "$ref": "#/$defs/protocolVersions" },
    "reasonCodes": {
      "type": "array",
      "minItems": 22,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reasonCode" }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionRequest",
        "versionResponse",
        "operationRequest",
        "operationResponse",
        "watchRequest",
        "events"
      ],
      "properties": {
        "versionRequest": { "$ref": "#/$defs/versionRequest" },
        "versionResponse": { "$ref": "#/$defs/versionResponse" },
        "operationRequest": { "$ref": "#/$defs/operationRequest" },
        "operationResponse": { "$ref": "#/$defs/operationResponse" },
        "watchRequest": { "$ref": "#/$defs/watchRequest" },
        "events": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operationEvent" }
        }
      }
    }
  },
  "$defs": {
    "apiVersion": {
      "const": "security.deus.dev/infrastructure-controller-protocol/v1alpha1"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "\\*|\\.\\." }
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
    },
    "protocolVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/protocolVersion" }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "reasonCode": {
      "enum": [
        "INFRA_PROTOCOL_UNSUPPORTED_VERSION",
        "INFRA_PROTOCOL_REQUIRED_FEATURE_UNAVAILABLE",
        "INFRA_PROTOCOL_DEPRECATED_VERSION",
        "INFRA_PROTOCOL_VERSION_SUNSET",
        "INFRA_PROTOCOL_REQUEST_INVALID",
        "INFRA_PROTOCOL_AUTHENTICATION_REQUIRED",
        "INFRA_PROTOCOL_ORGANIZATION_DENIED",
        "INFRA_PROTOCOL_TENANT_DENIED",
        "INFRA_PROTOCOL_OPERATION_DENIED",
        "INFRA_PROTOCOL_CLAIM_CONFLICT",
        "INFRA_PROTOCOL_IDEMPOTENCY_CONFLICT",
        "INFRA_PROTOCOL_PLAN_REQUIRED",
        "INFRA_PROTOCOL_PLAN_STALE",
        "INFRA_PROTOCOL_APPROVAL_REQUIRED",
        "INFRA_PROTOCOL_DEADLINE_EXCEEDED",
        "INFRA_PROTOCOL_OPERATION_NOT_FOUND",
        "INFRA_PROTOCOL_CURSOR_INVALID",
        "INFRA_PROTOCOL_CURSOR_EXPIRED",
        "INFRA_PROTOCOL_CURSOR_SUBJECT_MISMATCH",
        "INFRA_PROTOCOL_PROVIDER_UNAVAILABLE",
        "INFRA_PROTOCOL_POLICY_DENIED",
        "INFRA_PROTOCOL_INTERNAL"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reasonCode" }
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "versionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "requestId",
        "supportedProtocolVersions",
        "requiredFeatures"
      ],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "InfrastructureControllerVersionRequest" },
        "requestId": { "$ref": "#/$defs/identifier" },
        "supportedProtocolVersions": { "$ref": "#/$defs/protocolVersions" },
        "requiredFeatures": { "$ref": "#/$defs/features" }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "replacementProtocolVersion",
        "sunsetEpochSeconds"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "replacementProtocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "sunsetEpochSeconds": { "$ref": "#/$defs/epoch" }
      }
    },
    "versionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "requestId",
        "compatible",
        "selectedProtocolVersion",
        "serverProtocolVersions",
        "availableFeatures",
        "reasonCodes",
        "deprecation"
      ],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "InfrastructureControllerVersionResponse" },
        "requestId": { "$ref": "#/$defs/identifier" },
        "compatible": { "type": "boolean" },
        "selectedProtocolVersion": {
          "oneOf": [{ "$ref": "#/$defs/protocolVersion" }, { "type": "null" }]
        },
        "serverProtocolVersions": { "$ref": "#/$defs/protocolVersions" },
        "availableFeatures": { "$ref": "#/$defs/features" },
        "reasonCodes": { "$ref": "#/$defs/reasonCodes" },
        "deprecation": {
          "oneOf": [{ "$ref": "#/$defs/deprecation" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "compatible": { "const": true } } },
          "then": {
            "properties": {
              "selectedProtocolVersion": { "$ref": "#/$defs/protocolVersion" }
            }
          },
          "else": {
            "properties": {
              "selectedProtocolVersion": { "type": "null" },
              "reasonCodes": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organizationId",
        "tenantId",
        "contextId",
        "claimId",
        "generation",
        "desiredStateDigest"
      ],
      "properties": {
        "organizationId": { "$ref": "#/$defs/identifier" },
        "tenantId": { "$ref": "#/$defs/identifier" },
        "contextId": { "$ref": "#/$defs/identifier" },
        "claimId": { "$ref": "#/$defs/identifier" },
        "generation": { "$ref": "#/$defs/epoch" },
        "desiredStateDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "operationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "protocolVersion",
        "requestId",
        "authorizationContextId",
        "target",
        "operation",
        "planDigest",
        "approvalIds",
        "idempotencyKey",
        "deadlineEpochSeconds"
      ],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "InfrastructureOperationRequest" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/identifier" },
        "authorizationContextId": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/target" },
        "operation": {
          "enum": ["plan", "reconcile", "observe", "cancel", "delete"]
        },
        "planDigest": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "approvalIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "idempotencyKey": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "deadlineEpochSeconds": { "$ref": "#/$defs/epoch" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operation": { "enum": ["reconcile", "delete"] } }
          },
          "then": {
            "properties": {
              "planDigest": { "$ref": "#/$defs/sha256" },
              "idempotencyKey": { "$ref": "#/$defs/identifier" }
            }
          }
        },
        {
          "if": {
            "properties": { "operation": { "enum": ["plan", "observe"] } }
          },
          "then": {
            "properties": {
              "planDigest": { "type": "null" },
              "approvalIds": { "type": "array", "maxItems": 0 },
              "idempotencyKey": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "cancel" } } },
          "then": {
            "properties": {
              "planDigest": { "type": "null" },
              "approvalIds": { "type": "array", "maxItems": 0 },
              "idempotencyKey": { "$ref": "#/$defs/identifier" }
            }
          }
        }
      ]
    },
    "operationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "protocolVersion",
        "requestId",
        "outcome",
        "operationId",
        "reasonCodes",
        "retryAfterSeconds"
      ],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "InfrastructureOperationResponse" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/identifier" },
        "outcome": { "enum": ["accepted", "rejected"] },
        "operationId": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "reasonCodes": { "$ref": "#/$defs/reasonCodes" },
        "retryAfterSeconds": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 86400 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "accepted" } } },
          "then": {
            "properties": {
              "operationId": { "$ref": "#/$defs/identifier" },
              "reasonCodes": { "type": "array", "maxItems": 0 },
              "retryAfterSeconds": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "operationId": { "type": "null" },
              "reasonCodes": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "watchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "protocolVersion",
        "requestId",
        "authorizationContextId",
        "organizationId",
        "tenantId",
        "operationId",
        "cursor",
        "maxEvents",
        "deadlineEpochSeconds"
      ],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "InfrastructureOperationWatchRequest" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/identifier" },
        "authorizationContextId": { "$ref": "#/$defs/identifier" },
        "organizationId": { "$ref": "#/$defs/identifier" },
        "tenantId": { "$ref": "#/$defs/identifier" },
        "operationId": { "$ref": "#/$defs/identifier" },
        "cursor": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^v1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
            },
            { "type": "null" }
          ]
        },
        "maxEvents": { "type": "integer", "minimum": 1, "maximum": 100 },
        "deadlineEpochSeconds": { "$ref": "#/$defs/epoch" }
      }
    },
    "operationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "protocolVersion",
        "operationId",
        "organizationId",
        "tenantId",
        "eventId",
        "sequence",
        "phase",
        "terminal",
        "generation",
        "desiredStateDigest",
        "occurredAt",
        "reasonCodes",
        "previousEventDigest",
        "eventDigest"
      ],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "InfrastructureOperationEvent" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "operationId": { "$ref": "#/$defs/identifier" },
        "organizationId": { "$ref": "#/$defs/identifier" },
        "tenantId": { "$ref": "#/$defs/identifier" },
        "eventId": { "$ref": "#/$defs/identifier" },
        "sequence": { "$ref": "#/$defs/epoch" },
        "phase": {
          "enum": [
            "accepted",
            "planning",
            "planned",
            "reconciling",
            "observing",
            "cancelling",
            "deleting",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "terminal": { "type": "boolean" },
        "generation": { "$ref": "#/$defs/epoch" },
        "desiredStateDigest": { "$ref": "#/$defs/sha256" },
        "occurredAt": { "$ref": "#/$defs/timestamp" },
        "reasonCodes": { "$ref": "#/$defs/reasonCodes" },
        "previousEventDigest": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "eventDigest": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": { "enum": ["succeeded", "failed", "cancelled"] }
            }
          },
          "then": { "properties": { "terminal": { "const": true } } },
          "else": { "properties": { "terminal": { "const": false } } }
        },
        {
          "if": { "properties": { "phase": { "const": "failed" } } },
          "then": {
            "properties": {
              "reasonCodes": { "type": "array", "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "reasonCodes": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
